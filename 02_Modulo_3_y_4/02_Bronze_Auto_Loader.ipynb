     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "display(spark.table(BRONZE).groupBy(\"source_file\").count().orderBy(\"source_file\"))"
   ]
