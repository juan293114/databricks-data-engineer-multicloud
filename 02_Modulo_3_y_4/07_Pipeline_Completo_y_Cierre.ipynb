    }
   },
   "outputs": [],
   "source": [
    "respuestas = {\n",
    "    \"1. Delta Lake\": \"Un log de transacciones: de ahí salen ACID, validación de esquema, versiones/time travel y CDF (notebooks 02 y 05).\",\n",
    "    \"2. Time travel\": \"VACUUM borra los archivos de versiones viejas: después ya no se puede viajar a ellas; por defecto conserva 7 días (notebook 05).\",\n",
    "    \"3. CDF\": \"Tablas grandes con pocos cambios por corrida, o cuando hay que propagar borrados: la siguiente capa procesa solo lo que cambió (notebooks 03 y 04).\",\n",
    "    \"4. Unity Catalog\": \"workspace = catálogo, lab_tvmaze_m34 = esquema, silver_episodes = tabla; los permisos se heredan hacia abajo (notebook 06).\",\n",
    "    \"5. Auto Loader\": \"Por el checkpoint: cloud_files_state(checkpoint) muestra cada archivo procesado; un archivo nunca entra dos veces (notebook 02).\",\n",
    "}\n",
    "for pregunta, respuesta in respuestas.items():\n",
    "    print(f\"{pregunta}\\n   → {respuesta}\\n\")"
   ]
